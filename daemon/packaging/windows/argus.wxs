<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4/v5/v6 source for the Argus per-machine MSI.

  Build (see build-msi.ps1) with the WiX dotnet tool:
    wix build argus.wxs -arch x64 -ext WixToolset.UI.wixext ^
      -d Version=1.0.0.0 ^
      -d SourceDir=..\..\..\dist\argus-daemon ^
      -d IcoPath=..\..\..\assets\argus.ico ^
      -d LicenseRtf=license.rtf ^
      -o Argus-Setup.msi

  SourceDir is the PyInstaller onedir output folder (argus-daemon.exe +
  _internal\...\); the <Files> wildcard below harvests it wholesale so the
  exe keeps its runtime DLLs/data alongside it (onedir needs both present,
  unlike the single self-contained exe onefile produced).

  Per-machine (Program Files) install: requires admin/UAC. Without a paid
  code-signing cert the elevation prompt shows "unknown publisher" — this is
  expected and unavoidable without buying a certificate.

  The MSI deliberately does NOT create an autostart entry; the app manages
  "Start with Windows" itself via a per-user HKCU\...\Run key (tray_ui.py).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Argus"
           Manufacturer="PierreGode"
           Version="$(var.Version)"
           UpgradeCode="92AA6D86-84AC-48E3-A271-DA423B1D5447"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Argus desktop daemon — Claude Code usage monitor"
                        Manufacturer="PierreGode" />

    <!-- Clean in-place upgrades: a newer version replaces the older one.
         AllowSameVersionUpgrades lets re-running the installer for the *same*
         version also upgrade in place, instead of failing with MSI error 1638
         ("Another version of this product is already installed") — the error
         you'd otherwise hit rebuilding/reinstalling a version.py bump locally
         without a fresh -BuildNumber. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Argus is already installed. Setup will now exit."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs ("Apps & features") metadata. -->
    <Icon Id="ArgusIcon" SourceFile="$(var.IcoPath)" />
    <Property Id="ARPPRODUCTICON" Value="ArgusIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/PierreGode/Argus" />
    <Property Id="ARPHELPLINK" Value="https://github.com/PierreGode/Argus" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Installed files: Program Files\Argus\ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Argus">
        <Component Id="AppIcon" Guid="*">
          <File Id="ArgusIcoFile" Source="$(var.IcoPath)" Name="argus.ico" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut. A shortcut component is classified as per-user
         data, so its keypath must be HKCU (ICE38/ICE43) and the component must
         not also carry per-machine data (ICE57). This is the canonical pattern
         and is correct even in a per-machine package: the shortcut still lands
         in the All-Users Start Menu; only the breadcrumb is per-user. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="ArgusStartMenu"
                  Name="Argus"
                  Description="Argus desktop daemon — Claude Code usage monitor"
                  Target="[INSTALLFOLDER]argus-daemon.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ArgusIcon" />
        <RemoveFolder Id="CleanupStartMenu" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\PierreGode\Argus"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Argus" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Professional install-dir dialog set + license page. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>

  <!-- The PyInstaller onedir output (argus-daemon.exe + _internal\...),
       harvested wholesale so file additions/removals between builds don't
       need hand-maintained <File> entries here. Preserves the source tree's
       relative layout under INSTALLFOLDER, which is required — onedir's exe
       only runs with _internal\ alongside it. -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
